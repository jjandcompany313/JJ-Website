# ==============================================================================
# JJ & COMPANY — LiteSpeed / Apache Server Configuration
# ==============================================================================

# 1. URL Canonicalization & 301 Redirects
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1a. Redirect HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://jjandcompany.net/$1 [R=301,L]

  # 1b. Redirect WWW to non-WWW
  RewriteCond %{HTTP_HOST} ^www\.jjandcompany\.net$ [NC]
  RewriteRule ^(.*)$ https://jjandcompany.net/$1 [R=301,L]

  # 1c. Redirect /index.html to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/
  RewriteRule ^index\.html$ https://jjandcompany.net/ [R=301,L]

  # 1d. Legacy product-detail.html redirect
  RewriteRule ^product-detail\.html$ https://jjandcompany.net/products.html [R=301,L]
</IfModule>

# Custom 404 Error Page
ErrorDocument 404 /404.html

# 2. Correct MIME Types
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/x-icon .ico
  AddType application/pdf .pdf
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
  AddType text/css .css
</IfModule>

# 3. Browser Caching (Expires & Cache-Control for High Speed & CWV)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML - no cache to always serve freshest content & updates
  ExpiresByType text/html "access plus 0 seconds"

  # Static Assets - 1 Year Cache
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # HTML Documents: revalidate
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Static Assets: 1 year cache
  <FilesMatch "\.(ico|pdf|jpg|jpeg|png|webp|css|js|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # Video Streaming
  <FilesMatch "\.(mp4|webm|ogg)$">
    Header set Accept-Ranges "bytes"
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>

# 4. Gzip / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
